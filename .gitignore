# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE - IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Android build outputs
build/
*/build/
**/build/

# Gradle
.gradle/
*/.gradle/
**/.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# Local config (contains machine-specific SDK paths — never commit)
local.properties
*/local.properties

# Pre-built binaries / archives
*.apk
*.aab
# *.aar excluded from build outputs but NOT from app/libs (vendor SDK)
build/**/*.aar
*.rar
*.zip

# Markdown docs (project-specific decision)
*.md

# Captures / profiling
captures/
.externalNativeBuild/
.cxx/

# keystore files
*.jks
*.keystore
keystore.properties

# Logs
*.log

# Sunmi PayLib AAR extraction artifacts (leak to repo root when AAR is unpacked by IDE)
/META-INF/
/com/
/sunmi/

# Local per-developer config for the gateway test scripts — holds the LFI API key, never commit.
P3HDPayDemo_src/P3HDPayDemo/scripts/bootstrap.env
