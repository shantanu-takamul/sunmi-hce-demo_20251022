<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppToolbar">
        <item name="android:background">@drawable/bg_toolbar</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="NavCard" parent="@style/AppCard">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="AccentButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/accent_dark</item>
    </style>

    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/btn_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/primary_dark</item>
    </style>

    <!--
      Void a sale. Filled error red because it is destructive, prominent, and only
      offered for a few seconds — the operator has to find it fast.
    -->
    <style name="DangerButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!--
      Refund. Same destructive intent, deliberately quieter than DangerButton: it
      stays on screen indefinitely and must not compete with Print Receipt.
    -->
    <style name="DangerOutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/error</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/error_soft</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="NumpadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/numpad_text</item>
        <item name="backgroundTint">@color/numpad_bg</item>
        <item name="strokeColor">@color/numpad_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/surface_pressed</item>
    </style>

    <style name="NumpadUtilityButton" parent="@style/NumpadButton">
        <item name="android:textColor">@color/error</item>
        <item name="backgroundTint">@color/numpad_action_bg</item>
        <item name="strokeColor">@color/error_soft</item>
    </style>

    <style name="TextSectionLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextScreenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBodyMuted">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="InputField">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ReceiptDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:gravity">top</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ReceiptDetailLabel">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ReceiptDetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">3</item>
    </style>

    <!--
      Print rendition of the receipt rows above.

      Every dimension is in px, and deliberately so. The paper is 384 dots wide
      full stop, so a print layout is the one place in the app measuring in device
      pixels is correct: px is the only unit that means the same thing on the head
      as it does in the layout pass. dp would be multiplied by the P3H's 1.6875
      density and sp would then be multiplied again by whatever font scale the
      operator has set, so a receipt would change size when nothing about the
      paper had.

      Colours are black, not the screen's greys. A thermal head has one ink and no
      shades of it, so a #64748B label is not a softer label, it is the same black
      arrived at through a dither.
    -->
    <style name="PrintReceiptRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12px</item>
        <item name="android:gravity">top</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!--
      144px holds the widest label, "Transaction ID", which measures 132px at 21px
      on this head, with a little slack for a font that is not byte-identical.
      It is no wider than that because every dot the label column gives back is a
      dot the value column gets, and the value column is where the 36 character
      UUIDs wrap: 220px puts them on two lines, 210px on three, the last of which
      carries two characters and a lot of white space.
    -->
    <style name="PrintReceiptLabel">
        <item name="android:layout_width">136px</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8px</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20px</item>
    </style>

    <style name="PrintReceiptValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">21px</item>
        <item name="android:textStyle">bold</item>
        <!-- Wallet ids and UUIDs run past the column; wrapping keeps them whole. -->
        <item name="android:maxLines">3</item>
    </style>
</resources>
