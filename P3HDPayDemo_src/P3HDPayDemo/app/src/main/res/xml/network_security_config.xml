<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust and cleartext policy for the terminal.

  Read the three blocks in order — Android applies the most specific match:

  1. base-config      everything not named below: system CAs only, no cleartext.
  2. localhost        the adb-reverse dev tunnel, the one place cleartext is allowed.
  3. rcbdc...gov.ae   the CBUAE on-premise environments (bootstrap, sit), whose
                      chain is rooted at the internal cbuae-CBDC-CA.

  The internal CA appears ONLY in block 3. Putting it in base-config would let
  anything that CA ever signs impersonate any host the terminal talks to,
  including the Cloudflare-fronted cloud backends. Both anchors are listed there
  because the domain is reachable only inside CB but the wildcard serving it
  could one day be reissued from a public CA; adding system alongside is
  additive, and widens nothing for any other host.

  This mirrors the wallet Android app's bootstrap flavour, which generates the
  same shape from INTERNAL_CA_TRUSTED_HOST in CI.

  A CA imported by the operator at runtime cannot be expressed here — there is no
  build-time file for it. That path is programmatic; see net/TrustStore.java.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local dev tunnel (adb reverse tcp:3000) and the emulator loopback alias. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!--
      CBUAE on-premise: bootstrap-api / sit-api and their siblings, served by
      APISIX behind the F5 VIP with the *.rcbdc.digitaldirham.gov.ae wildcard.
      Root: CN=cbuae-CBDC-CA, DC=cbuae, DC=gov — self-signed, valid to 2030-11-18.
      A root rotation means reshipping the APK; see POS_BOOTSTRAP_BRAIN.md 5.4.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">rcbdc.digitaldirham.gov.ae</domain>
        <trust-anchors>
            <certificates src="@raw/cbuae_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
