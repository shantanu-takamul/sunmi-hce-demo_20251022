<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll_receipt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/layout_success_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!--
                  Hero state. Swapped wholesale when a cancel succeeds — see
                  PaymentSuccessActivity#showVoidedHero. Ids exist purely so that
                  swap is possible; a void must not sit under a green tick.
                -->
                <FrameLayout
                    android:id="@+id/frame_status_icon"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_soft_success_circle">

                    <ImageView
                        android:id="@+id/iv_status_icon"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_status_heading"
                    style="@style/TextScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/payment_success_heading" />

                <TextView
                    android:id="@+id/tv_status_subtext"
                    style="@style/TextBodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/AppCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ref"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_date_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_receipt"
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/layout_receipt_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/payment_success_receipt_title"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_receipt_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_receipt_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/success"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/row_transaction_id"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_transaction_id" />

                        <TextView
                            android:id="@+id/tv_receipt_transaction_id"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_request_id"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_request_id" />

                        <TextView
                            android:id="@+id/tv_receipt_request_id"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_date"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_date" />

                        <TextView
                            android:id="@+id/tv_receipt_date"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_currency"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_currency" />

                        <TextView
                            android:id="@+id/tv_receipt_currency"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_payer"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_payer" />

                        <TextView
                            android:id="@+id/tv_receipt_payer"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_terminal"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_terminal" />

                        <TextView
                            android:id="@+id/tv_receipt_terminal"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_merchant"
                        style="@style/ReceiptDetailRow">

                        <TextView
                            style="@style/ReceiptDetailLabel"
                            android:text="@string/payment_success_merchant" />

                        <TextView
                            android:id="@+id/tv_receipt_merchant"
                            style="@style/ReceiptDetailValue" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/payment_success_receipt_footer"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layout_printed_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_soft_success_circle">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check" />
                </FrameLayout>

                <TextView
                    style="@style/TextScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/payment_success_receipt_printed" />

                <TextView
                    style="@style/TextBodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/payment_success_receipt_printed_message" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!--
      Return action slot. Holds at most one visible button: CANCEL while the void
      window is open, REFUND once it has closed. Sits outside the ScrollView so it
      stays reachable no matter how far the receipt has been scrolled — the cancel
      window is only ten seconds and must never be below the fold.
    -->
    <LinearLayout
        android:id="@+id/layout_return_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_return_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_payment"
            style="@style/DangerButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refund_payment"
            style="@style/DangerOutlineButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/payment_success_refund"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_primary"
            style="@style/AccentButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/payment_success_view_details" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_return"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/payment_success_return" />
    </LinearLayout>
</LinearLayout>
