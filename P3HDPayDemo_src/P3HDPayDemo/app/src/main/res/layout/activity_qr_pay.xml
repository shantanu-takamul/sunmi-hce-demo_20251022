<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ─── INPUT STATE ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Amount display header (blue band) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMOUNT (AED)"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tv_amount_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Numpad area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@color/background">

                <!-- Row 1: 1 2 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_1" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="1" />
                    <Button android:id="@+id/btn_2" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="2" />
                    <Button android:id="@+id/btn_3" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="3" />
                </LinearLayout>

                <!-- Row 2: 4 5 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_4" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="4" />
                    <Button android:id="@+id/btn_5" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="5" />
                    <Button android:id="@+id/btn_6" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="6" />
                </LinearLayout>

                <!-- Row 3: 7 8 9 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_7" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="7" />
                    <Button android:id="@+id/btn_8" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="8" />
                    <Button android:id="@+id/btn_9" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="9" />
                </LinearLayout>

                <!-- Row 4: . 0 ⌫ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_dot" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="." />
                    <Button android:id="@+id/btn_0" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp" android:text="0" />
                    <Button android:id="@+id/btn_backspace" style="@style/NumpadButton"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_margin="4dp"
                        android:text="&#x232B;"
                        android:textColor="@color/error" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@color/background">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate"
                    style="@style/AccentButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/qr_pay_generate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nfc_pay"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/qr_pay_nfc" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── LOADING STATE ────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/background"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_pay_status_generating"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
