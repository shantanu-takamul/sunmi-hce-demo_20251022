<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Amount + Status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tx_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tx_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Date + short Transaction ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tx_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_tx_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 3: Payer wallet -->
    <TextView
        android:id="@+id/tv_tx_payer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

    <!-- Transaction type label (e.g. PAY_TO_MERCHANT, MERCHANT_REFUND) -->
    <TextView
        android:id="@+id/tv_tx_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp" />

    <!-- Refunded badge (shown when hasSuccessRefund=true) -->
    <TextView
        android:id="@+id/tv_refunded_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:background="@color/surface_subtle"
        android:text="@string/tx_already_refunded"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Refund Pending badge (shown when hasPendingRefund=true and not yet succeeded) -->
    <TextView
        android:id="@+id/tv_refund_pending_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:background="@color/warning_soft"
        android:text="@string/tx_refund_pending"
        android:textColor="@color/warning"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Row 4: Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="@string/tx_view"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/surface_subtle"
            app:cornerRadius="6dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refund"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="@string/tx_refund"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="6dp" />
    </LinearLayout>
</LinearLayout>
